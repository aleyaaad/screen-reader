{
  "manifest_version": 3,
  "name": "Vision Assist",
  "version": "0.0.1",
  "author": "Aleysa",
  "description": "Screen Reader Assistant with object detection + scanning overlay + elevenlabs speech.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Screen Reader Assistant",
    "default_icon": "Vision.png"


  },

  
  "icons": {
    "128": "Vision.png"
  },



  "options_page": "options.html",

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentscript.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["activeTab", "scripting", "tabs", "storage"],

  "host_permissions": [
    "<all_urls>",
    "https://router.huggingface.co/*",
    "https://api.elevenlabs.io/*"
  ]
}
