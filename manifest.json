{
  "manifest_version": 3,
  "name": "Vision Assist",
  "version": "0.0.1",
  "author": "Aleysa",
  "description": "Screen Reader Assistant with object detection + scanning overlay + elevenlabs speech.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Vision Assist"
  },

  "options_page": "options.html",

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentscript.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://router.huggingface.co/*",
    "https://api.elevenlabs.io/*"
  ],

  "commands": {
    "visionassist-read-selection": {
      "suggested_key": { "default": "Shift+R" },
      "description": "Read highlighted text aloud"
    },
    "visionassist-describe-image": {
      "suggested_key": { "default": "Shift+I" },
      "description": "Describe hovered image aloud"
    },
    "visionassist-scan-screen": {
      "suggested_key": { "default": "Shift+S" },
      "description": "Scan the visible screen and describe it aloud"
    }
  }
}
