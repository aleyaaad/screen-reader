{
  "manifest_version": 3,
  "name": "Vision Assist",
  "version": "0.0.1",
  "author": "Aleysa",
  "description": "Screen Reader Assistant with object detection + scanning overlay + elevenlabs speech.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Vision Assist"
    
  },



  "options_page": "options.html",

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentscript.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "commands": {
  "scan-screen": {
    "suggested_key": {
      "default": "Alt+Shift+S",
      "mac": "Command+Shift+S"
    },
    "description": "Scan screen for objects (DETR) and speak results"
  },
  "read-selection": {
    "suggested_key": {
      "default": "Alt+Shift+R",
      "mac": "Command+Shift+R"
    },
    "description": "Read selected text aloud"
  },
  "describe-image": {
    "suggested_key": {
      "default": "Alt+Shift+I",
      "mac": "Command+Shift+I"
    },
    "description": "Describe the last clicked image"
  }
},


  "host_permissions": [
    "<all_urls>",
    "https://router.huggingface.co/*",
    "https://api.elevenlabs.io/*"
  ]
}
