{
  "manifest_version": 3,
  "name": "screen_reader",
  "version": "0.0.1",
  "author": "Aleysa",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Screen Reader Assistant"
  },

  "options_page": "options.html",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentscript.js"]
    }
  ],


  "background": {
    "service_worker": "background.js"
  },

  "permissions": ["activeTab", "scripting", "tabs"],

  "host_permissions": ["<all_urls>"]
  

}
